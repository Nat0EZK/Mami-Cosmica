      "css": ".ds-tone-session{--tone:var(--color-violet,#6B4FA8);--tone-soft:var(--color-violet-soft,#EDE6F8);--tone-mark:var(--color-violet-mark,#CDBDEE);} .ds-tone-shop{--tone:var(--color-rose,#A93E70);--tone-soft:var(--color-rose-soft,#FBE8EF);--tone-mark:var(--color-rose-mark,#EDB5CB);} .ds-field{background:var(--tone);padding:24px;border-radius:14px;} .ds-btn-white{display:inline-flex;min-height:3rem;align-items:center;justify-content:center;gap:.5rem;border:0;border-radius:999px;padding:.75rem 1.6rem;font:600 .9375rem/1 \"Hanken Grotesk\",system-ui,sans-serif;letter-spacing:.01em;cursor:pointer;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 200ms ease,color 200ms ease;background:#fff;color:var(--tone);} .ds-btn-white:hover{background:var(--tone-soft);} .ds-btn-white:focus-visible{outline:2px solid #fff;outline-offset:3px;} .ds-btn-white:active{transform:scale(.97);}"
