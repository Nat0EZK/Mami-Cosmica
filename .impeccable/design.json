      "html": "<button class=\"ds-acc\" aria-expanded=\"true\"><span class=\"ds-acc__q\">¿Las sesiones son online?</span><span class=\"ds-acc__icon\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></span></button>",
      "css": ".ds-acc{display:flex;width:100%;min-height:4rem;align-items:center;justify-content:space-between;gap:1rem;padding:20px 0;background:none;border:0;border-bottom:1px solid var(--color-line,#DED3EB);text-align:left;cursor:pointer;} .ds-acc__q{font:400 1.375rem/1.35 Gloock,Georgia,serif;color:var(--color-ink,#2E1F3D);transition:color 200ms;} .ds-acc:hover .ds-acc__q{color:var(--color-violet,#6B4FA8);} .ds-acc__icon{display:grid;place-items:center;width:32px;height:32px;flex-shrink:0;border-radius:999px;color:var(--color-violet,#6B4FA8);box-shadow:0 0 0 1px var(--color-line,#DED3EB);transition:transform 300ms cubic-bezier(.23,1,.32,1),background-color 300ms;} .ds-acc[aria-expanded=\"true\"] .ds-acc__icon{transform:rotate(45deg);background:var(--color-violet,#6B4FA8);color:#fff;box-shadow:0 0 0 1px var(--color-violet,#6B4FA8);} .ds-acc:focus-visible{outline:2px solid var(--color-violet,#6B4FA8);outline-offset:3px;}"
