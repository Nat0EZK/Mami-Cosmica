      "html": "<a class=\"ds-btn-violet\" href=\"#\">Agendar sesión</a>",
      "css": ".ds-btn-violet{display:inline-flex;min-height:3rem;align-items:center;justify-content:center;gap:.5rem;border:0;border-radius:999px;padding:.75rem 1.6rem;font:600 .9375rem/1 \"Hanken Grotesk\",system-ui,sans-serif;letter-spacing:.01em;cursor:pointer;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 200ms ease,color 200ms ease;background:var(--color-violet,#6B4FA8);color:#fff;} .ds-btn-violet:hover{background:var(--color-violet-2,#5A4192);} .ds-btn-violet:focus-visible{outline:2px solid var(--color-violet,#6B4FA8);outline-offset:3px;} .ds-btn-violet:active{transform:scale(.97);}"
